// Signing for the App Store and TestFlight. To build under another team (for
// a fork, say), override these in Config/Signing.local.xcconfig (ignored by
// git):
//
//   HEDERA_BUNDLE_ID = com.yourname.hedera
//   HEDERA_TEAM_ID = ABCDE12345

HEDERA_BUNDLE_ID = com.sprigbyte.hedera
HEDERA_TEAM_ID = 5CLNYT78JN

// The push relay (relay/README.md), as a host name: xcconfig treats // as a
// comment, so no https://. Empty builds an app without notifications.
HEDERA_RADIX_HOST =

#include? "Signing.local.xcconfig"
